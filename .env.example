# Financial Advisor — Environment Configuration
# Copy to .env and update values before running

# LLM Configuration
LLM_MODEL=llama3.1:8b
LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=30

# Security (CHANGE THESE IN PRODUCTION)
JWT_SECRET=generate-a-strong-random-secret-minimum-256-bits
JWT_EXPIRY_MINUTES=60
ENCRYPTION_KEY=generate-a-32-byte-key-for-aes-256-encryption

# Default user (V1 single-user)
JWT_DEFAULT_USER=admin
JWT_DEFAULT_PASSWORD=changeme

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Financial Engine Defaults
STALENESS_THRESHOLD_DAYS=7
EMERGENCY_MONTHS_THRESHOLD=6
